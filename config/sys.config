[
 {beamchain, [
   {network, testnet4},
   %% datadir intentionally not set: falls back to the default (~/.beamchain).
   %% Override per-deployment with the BEAMCHAIN_DATADIR env var or
   %% --datadir=DIR CLI flag.
   {p2pport, 48338},
   {rpcport, 48348}
 ]},
 {kernel, [
   {logger_level, info}
 ]},
 {sasl, [
   {sasl_error_logger, false}
 ]}
].
